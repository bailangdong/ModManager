<!--
  Profiles page. Switching a profile redeploys from manifests rather than restoring a snapshot, and the
  description says so — a user should know that switching is a real deployment operation, not a setting.
-->
<UserControl x:Class="ModManager.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModManager.App.Views"
             Background="Transparent">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BrushPassThroughConverter x:Key="BrushPass" />
  </UserControl.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="配置方案" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="切换配置方案会部署该方案的 Mod，并移除上一个方案添加的 Mod。你手动修改过的文件会被保留。"
                   Style="{StaticResource CaptionText}" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   Style="{StaticResource AppTextBox}"
                   Margin="0,0,10,0"
                   Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="例如 原版、测试 或 大型整合包" />

          <Button Grid.Column="1"
                  Style="{StaticResource PrimaryButton}"
                  Content="创建配置方案"
                  Command="{Binding CreateCommand}" />
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleText}" />
                    <Border Style="{StaticResource StatusPill}"
                            Background="{Binding Fill, Converter={StaticResource BrushPass}}"
                            Margin="10,0,0,0">
                      <TextBlock Text="{Binding StateText}"
                                 Style="{StaticResource StatusPillText}"
                                 Foreground="{Binding Tone, Converter={StaticResource BrushPass}}" />
                    </Border>
                  </StackPanel>

                  <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ModSummary}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding RuleSummary}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding DeployedText}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource PrimaryButton}"
                          Content="切换到此方案"
                          Margin="0,0,8,0"
                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                          Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Style="{StaticResource SecondaryButton}"
                          Content="复制"
                          Margin="0,0,8,0"
                          Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Style="{StaticResource DangerButton}"
                          Content="删除"
                          Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
