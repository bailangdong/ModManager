<Window x:Class="ModManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModManager.App.ViewModels"
        xmlns:local="clr-namespace:ModManager.App.Views"
        Title="Mod Manager"
        Height="880"
        Width="1440"
        MinHeight="620"
        MinWidth="1024"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBoolConverter x:Key="InverseBool" />
  </Window.Resources>

  <!--
    Shell layout: a narrow rail, a single top bar, and the page host.

    Why it is shaped this way:
      * The rail is 204px, not a wide panel with cards in it. Navigation is a list of destinations; giving
        it a third of the window makes every page narrower for no benefit, and a desktop tool that wastes
        horizontal space is the thing users notice first.
      * There is no bottom status bar. Status text and the busy indicator live in the top bar, where they
        are read at the same glance as the page they describe. A permanent 28px strip across the bottom of
        the window to say "ready" is decoration, not information.
      * The active game sits at the left of the top bar rather than in the rail. It is the target of nearly
        every action on every page, so it has to be visible while reading the page — and it is the one
        piece of rail content that genuinely belongs beside the content it applies to.
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="204" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================== Navigation rail ===================== -->
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,14">

        <!-- Brand -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
          <Border Width="28" Height="28"
                  CornerRadius="8"
                  Background="{DynamicResource AccentBrush}">
            <TextBlock Text="M"
                       Foreground="{DynamicResource OnAccentBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="ModManager"
                     Style="{StaticResource SubtitleText}"
                     Margin="9,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!--
          Bound rather than declared: pages are filtered by the active game's declared capabilities, so a
          game with no load order shows no Load Order page instead of a disabled one.
        -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PageGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource NavGroupText}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Title}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Pages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton Style="{StaticResource NavButton}"
                                   GroupName="ShellNav"
                                   Content="{Binding Name}"
                                   ToolTip="{Binding Description}"
                                   Checked="OnNavigationChecked" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Connection state, kept quiet at the foot of the rail. -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{StaticResource Divider}" Margin="4,0,4,10" />
          <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
            <Ellipse Width="7" Height="7"
                     Fill="{DynamicResource SuccessBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="已连接 Nexus"
                       Style="{StaticResource CaptionText}"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="v1.0"
                     Style="{StaticResource CaptionText}"
                     Foreground="{DynamicResource TextDisabledBrush}"
                     Margin="6,5,0,0" />
        </StackPanel>

        <Border />
      </DockPanel>
    </Border>

    <!-- ===================== Content ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--
        Top bar: the active game, the global search, and the window actions.

        One row, 52px, and nothing in it is decorative — every element either states what the next action
        applies to or performs one.
      -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="20,0"
              Height="52">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Active game: cover, name, and what its adapter supports. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="300">
            <Border Width="26" Height="26"
                    CornerRadius="6"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    VerticalAlignment="Center">
              <Border.Clip>
                <RectangleGeometry Rect="0,0,26,26" RadiusX="6" RadiusY="6" />
              </Border.Clip>
              <Image Source="{Binding ActiveGameCover}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveGameDescription}"
                         Style="{StaticResource BodyText}"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="240" />
              <TextBlock Text="{Binding CapabilitySummary}"
                         Style="{StaticResource CaptionText}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="240" />
            </StackPanel>
          </StackPanel>

          <!-- Global search. -->
          <Border Grid.Column="1"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource ControlRadius}"
                  Height="32"
                  Width="320"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="&#xE721;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="12"
                         Foreground="{DynamicResource TextDisabledBrush}"
                         VerticalAlignment="Center"
                         Margin="10,0,7,0" />
              <TextBox Grid.Column="1"
                       Style="{StaticResource BareTextBox}"
                       VerticalContentAlignment="Center"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                       ToolTip="搜索 Mod（在 Mod 管理页生效）" />
            </Grid>
          </Border>

          <!-- Status, busy indicator and window actions. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,10,0" />
            <ProgressBar Style="{StaticResource AppProgressBar}"
                         Width="60"
                         Height="3"
                         IsIndeterminate="True"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE72C;"
                    ToolTip="刷新当前页面（F5）"
                    Command="{Binding RefreshCommand}" />
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE713;"
                    ToolTip="设置"
                    Command="{Binding OpenSettingsCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Page host. App.xaml maps the view-model type to its view. -->
      <ContentControl Grid.Row="1" Content="{Binding ActivePage}" />
    </Grid>
  </Grid>
</Window>
