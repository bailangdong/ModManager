<!--
  Conflicts page. Shows the chain the spec asks for — who provides a path and who overrides it — and offers
  the three resolutions: keep the winner, invert it, or drop the rule and let load order decide.

  The list row names the contested path first, then the winner and the overridden providers on their own
  labelled lines. A single "A → path → B 生效" sentence made the reader parse the punctuation to learn who
  actually wins; the labels say it outright. The detail pane is deliberately empty until a row is selected,
  with an instruction instead of three dead buttons and two empty cards.
-->
<UserControl x:Class="ModManager.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModManager.App.Views"
             Background="Transparent">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BrushPassThroughConverter x:Key="BrushPass" />

    <!-- The list row's card doubles as the selection indicator: the ListBoxItem template's own highlight
         sits behind an opaque card, so a selected row would otherwise look identical to an unselected one. -->
    <Style x:Key="ConflictRowCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="冲突" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
      <TextBlock Text="任何覆盖都不会静默发生：有争议的文件始终由加载顺序或你设置的规则解决。"
                 Style="{StaticResource CaptionText}"
                 Margin="0,6,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- MinWidth 360, not 420: with the detail pane at 380 the pair needs 360+380+16 = 756, which fits the
             764 available inside a 1024-wide window. At 420+460+16 = 896 the right pane was pushed out of view
             at the window's own minimum width. -->
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0"
               Style="{StaticResource AppListBox}"
               ItemContainerStyle="{StaticResource AppListBoxItem}"
               ItemsSource="{Binding Conflicts}"
               SelectedItem="{Binding SelectedConflict, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource ConflictRowCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding RelativeTarget}" Style="{StaticResource MonoText}" />

                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="胜出"
                               Style="{StaticResource CaptionText}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding WinnerModId}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>

                  <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="被覆盖"
                               Style="{StaticResource CaptionText}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding OverriddenText}"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="原因" Style="{StaticResource CaptionText}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource StatusPill}"
                        Background="{Binding Fill, Converter={StaticResource BrushPass}}"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0">
                  <TextBlock Text="{Binding StatusText}"
                             Style="{StaticResource StatusPillText}"
                             Foreground="{Binding Tone, Converter={StaticResource BrushPass}}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty state sits over the list column: an empty ListBox has no chrome to explain itself. -->
      <Border Grid.Column="0"
              Style="{StaticResource Card}"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Padding="24,20"
              Margin="0,8,0,0"
              Visibility="{Binding Conflicts.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="没有检测到冲突" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" />
          <TextBlock Text="当两个 Mod 提供同一个文件时，这里会列出覆盖链和解决方式。"
                     Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Width="380" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
        <StackPanel>
          <!-- Nothing selected yet: say what to do instead of showing inert controls. -->
          <Border Style="{StaticResource Card}"
                  Visibility="{Binding SelectedConflict, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel>
              <TextBlock Text="选择一个冲突" Style="{StaticResource SubtitleText}" />
              <TextBlock Text="左侧每一行是一个被多个 Mod 覆盖的文件。选中后这里会显示胜出者、覆盖链、原因，以及三种解决方式。"
                         Style="{StaticResource SecondaryText}"
                         Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}"
                  Visibility="{Binding SelectedConflict, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="解决方案" Style="{StaticResource SectionHeaderText}" />
              <TextBlock Text="{Binding Explanation}" Style="{StaticResource BodyText}" />

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="保持当前胜者"
                        Margin="0,0,8,0"
                        ToolTip="为这个文件写一条规则，固定当前的胜出者"
                        Command="{Binding PreferWinnerCommand}"
                        CommandParameter="{Binding SelectedConflict}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Content="改用另一个 Mod"
                        Margin="0,0,8,0"
                        ToolTip="为这个文件写一条规则，让被覆盖的 Mod 胜出"
                        Command="{Binding PreferLoserCommand}"
                        CommandParameter="{Binding SelectedConflict}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Content="清除规则"
                        ToolTip="删除该文件的规则，回到按加载顺序决定"
                        Command="{Binding ClearRuleCommand}"
                        CommandParameter="{Binding SelectedConflict}" />
              </StackPanel>

              <TextBlock Text="规则只作用于一个文件。重新部署后生效。"
                         Style="{StaticResource CaptionText}"
                         Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}"
                  Margin="0,10,0,0"
                  Visibility="{Binding SelectedConflict, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="谁提供了这个文件" Style="{StaticResource SectionHeaderText}" />
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0"
                              Style="{StaticResource StatusPill}"
                              Background="{Binding Fill, Converter={StaticResource BrushPass}}"
                              VerticalAlignment="Top"
                              Margin="0,0,10,0">
                        <TextBlock Text="{Binding StateText}"
                                   Style="{StaticResource StatusPillText}"
                                   Foreground="{Binding Tone, Converter={StaticResource BrushPass}}" />
                      </Border>

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ModName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MonoText}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
