<!--
  Downloads page. Resumability is surfaced explicitly, because a download that cannot resume behaves
  differently when paused and the user should not have to discover that by losing progress.

  Row anatomy: the name and state badge are the scan target, the transfer metrics are a wrapped caption
  line, and the progress bar carries its own percentage. The metrics wrap rather than sitting in one
  never-ending horizontal strip, so a narrow window loses height instead of clipping the last value.
-->
<UserControl x:Class="ModManager.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModManager.App.Views"
             Background="Transparent">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BrushPassThroughConverter x:Key="BrushPass" />
  </UserControl.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="下载" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
      </StackPanel>

      <Button Grid.Column="1"
              Style="{StaticResource SecondaryButton}"
              Content="全部暂停"
              VerticalAlignment="Top"
              ToolTip="暂停所有进行中的下载；已暂停的任务可以随时继续"
              Command="{Binding PauseAllCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Empty state: one compact card instead of a bare line of text floating at the top. -->
        <Border Style="{StaticResource Card}"
                HorizontalAlignment="Center"
                Padding="28,24"
                Margin="0,40,0,0"
                Visibility="{Binding Downloads.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="没有正在进行的下载"
                       Style="{StaticResource SubtitleText}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="压缩包会下载到缓存目录并校验，绝不会直接写入游戏目录。"
                       Style="{StaticResource CaptionText}"
                       Margin="0,8,0,0"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Downloads}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <!-- Name and state share a grid so a long mod name trims instead of pushing the badge away. -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Style="{StaticResource StatusPill}"
                                Background="{Binding Fill, Converter={StaticResource BrushPass}}"
                                Margin="10,0,0,0">
                          <TextBlock Text="{Binding StateText}"
                                     Style="{StaticResource StatusPillText}"
                                     Foreground="{Binding Tone, Converter={StaticResource BrushPass}}" />
                        </Border>
                      </Grid>

                      <!-- Metrics wrap: the window can get narrower without the last value disappearing. -->
                      <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding ResumeText}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding HashText}" Style="{StaticResource CaptionText}" />
                      </WrapPanel>

                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="来源" Style="{StaticResource CaptionText}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <TextBlock Text="{Binding ErrorText}"
                                 Style="{StaticResource CaptionText}"
                                 Foreground="{DynamicResource DangerBrush}"
                                 Margin="0,5,0,0"
                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource SecondaryButton}" Content="暂停" Margin="0,0,6,0"
                              Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource SecondaryButton}" Content="继续" Margin="0,0,6,0"
                              Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource SecondaryButton}" Content="重试" Margin="0,0,6,0"
                              Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource DangerButton}" Content="取消" Margin="0,0,6,0"
                              Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                              Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource SecondaryButton}" Content="移除"
                              ToolTip="从列表移除该记录；暂停或进行中的任务请先取消"
                              Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>

                  <!-- Bar and percentage are one unit: the number belongs to the bar it describes. -->
                  <Grid Margin="0,12,0,0"
                        Visibility="{Binding HasTotal, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Style="{StaticResource AppProgressBar}"
                                 Maximum="1"
                                 Value="{Binding Fraction, Mode=OneWay}"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PercentText}"
                               Style="{StaticResource CaptionText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
