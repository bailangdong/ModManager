<!--
  Logs page: the structured log tail and the transaction journal.

  Both are on one page on purpose. They answer the same question — what did this application actually do —
  and a journal that cannot be read is not much of a recovery guarantee, so the transaction list is
  surfaced next to the log rather than hidden.

  A log tail is read by scanning, so its rows are flat (no shadow, tighter radius) and the selected row gets
  an accent surface as well as an accent border: the ListBoxItem template's own highlight is hidden behind
  an opaque row card. The detail pane starts with an instruction instead of an empty box and a button that
  appears to do nothing.
-->
<UserControl x:Class="ModManager.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModManager.App.Views"
             xmlns:core="clr-namespace:ModManager.Core;assembly=ModManager.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BrushPassThroughConverter x:Key="BrushPass" />
    <local:ChineseEnumConverter x:Key="ChineseEnum" />

    <!--
      The level choices are the enum's own values rather than a hand-written list of strings, so a new
      level added to LogLevel appears here automatically. ObjectDataProvider is used because a
      ComboBox needs an IEnumerable it can enumerate, and an enum type is not one.
    -->
    <ObjectDataProvider x:Key="LogLevels" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="core:LogLevel" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <!-- A flat row card: the card shadow repeated on every entry is visual noise and an effect per row. -->
    <Style x:Key="LogRowCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Effect" Value="{x:Null}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="Padding" Value="10,8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="日志" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,8,0">
        <TextBox Style="{StaticResource AppTextBox}"
                 MinWidth="200"
                 Margin="0,0,8,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="搜索日志（类别 / 消息 / 详情）" />
        <TextBlock Text="级别" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Style="{StaticResource AppComboBox}"
                  ItemContainerStyle="{StaticResource AppComboBoxItem}"
                  MinWidth="120"
                  ItemsSource="{Binding Source={StaticResource LogLevels}}"
                  SelectedItem="{Binding MinimumLevel, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource ChineseEnum}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Style="{StaticResource SecondaryButton}"
                Content="清空显示"
                Margin="0,0,8,0"
                ToolTip="只清空屏幕上的列表，不会删除日志文件"
                Command="{Binding ClearDisplayCommand}" />
        <Button Style="{StaticResource SecondaryButton}"
                Content="刷新"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <!-- ===== Body: log tail + transaction list ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- MinWidth 360, not 460: at 460+460+16 = 936 the transaction pane was clipped by about 96px inside a
             1024-wide window. 360+380+16 = 756 leaves the list the flexible half, which is what it is. -->
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0"
               Style="{StaticResource AppListBox}"
               ItemContainerStyle="{StaticResource AppListBoxItem}"
               ItemsSource="{Binding Entries}"
               SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource LogRowCard}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding TimeText}"
                           Style="{StaticResource MonoText}"
                           VerticalAlignment="Top"
                           Margin="0,0,10,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding LevelText}"
                           Style="{StaticResource MonoText}"
                           Foreground="{Binding Tone, Converter={StaticResource BrushPass}}"
                           VerticalAlignment="Top"
                           MinWidth="76"
                           Margin="0,0,10,0" />

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CaptionText}" />
                  <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty state: "no rows" is not the same thing as "nothing matched the filter". -->
      <Border Grid.Column="0"
              Style="{StaticResource FlatCard}"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Padding="24,20"
              Margin="0,8,0,0"
              Visibility="{Binding Entries.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="没有匹配的日志" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" />
          <TextBlock Text="调低级别筛选，或清空搜索词后重试。"
                     Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Width="380" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
        <StackPanel>
          <!-- Selected entry detail -->
          <Border Style="{StaticResource Card}"
                  Visibility="{Binding SelectedEntry, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="条目详情" Style="{StaticResource SectionHeaderText}" />
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Content="复制"
                        ToolTip="复制完整时间戳、级别、类别、消息与详情"
                        Command="{Binding CopySelectedCommand}" />
              </Grid>
              <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource MonoText}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}"
                  Visibility="{Binding SelectedEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel>
              <TextBlock Text="条目详情" Style="{StaticResource SectionHeaderText}" />
              <TextBlock Text="选择左侧任意一条日志，这里会显示它的完整时间戳、级别、类别与详情。"
                         Style="{StaticResource SecondaryText}" />
            </StackPanel>
          </Border>

          <!-- Transactions -->
          <TextBlock Text="事务" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8" />
          <TextBlock Text="还没有事务记录。"
                     Style="{StaticResource SecondaryText}"
                     Visibility="{Binding Transactions.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

          <ItemsControl ItemsSource="{Binding Transactions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TransactionId}" Style="{StaticResource MonoText}" />
                        <TextBlock Text="{Binding StartedText}" Style="{StaticResource CaptionText}" />
                      </StackPanel>

                      <Border Grid.Column="1"
                              Style="{StaticResource StatusPill}"
                              Background="{Binding Fill, Converter={StaticResource BrushPass}}"
                              VerticalAlignment="Top">
                        <TextBlock Text="{Binding StateText}"
                                   Style="{StaticResource StatusPillText}"
                                   Foreground="{Binding Tone, Converter={StaticResource BrushPass}}" />
                      </Border>
                    </Grid>

                    <TextBlock Text="{Binding GameId}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StepSummary}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding ModsText}" Style="{StaticResource CaptionText}" />

                    <TextBlock Text="{Binding ErrorText}"
                               Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,5,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Only shown when a transaction still needs recovery, which is the one case that
                         requires the user to do something rather than merely read. -->
                    <Border Style="{StaticResource Callout}"
                            Background="{DynamicResource WarningFillBrush}"
                            Margin="0,8,0,0"
                            Visibility="{Binding NeedsRecovery, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="该事务曾被中断。下次启动应用时会自动修复。"
                                 Style="{StaticResource CaptionText}" />
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ===== Footer ===== -->
    <TextBlock Grid.Row="2"
               Text="日志条目在存储前经过脱敏：API Key、Bearer Token 和签名下载链接不会出现在此列表或日志文件中。"
               Style="{StaticResource CaptionText}"
               Margin="0,12,0,0" />
  </Grid>
</UserControl>
