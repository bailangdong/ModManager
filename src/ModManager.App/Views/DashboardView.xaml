<UserControl x:Class="ModManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModManager.App.Views"
             Background="Transparent"
             FontFamily="{StaticResource UiFont}">

  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BrushPassThroughConverter x:Key="BrushPass" />
  </UserControl.Resources>

  <!--
    Dashboard.

    Not a wall of metric tiles. The six large stat cards that used to open this page are now one quiet row
    of pills in the header: a number a user reads once does not deserve the same visual weight as the game
    they are about to deploy into. The only raised surface on the page is the active game — every other
    group is a flat section, so the page has exactly one visual protagonist.

    Type scale: page title 22, section titles 15 (SubtitleText), body 13, helper text 12 (CaptionText).
    Section titles were 11 before, i.e. the same size as the captions under them, which is why the page
    read as one undifferentiated block of grey.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel>

      <!-- ===================== Header ===================== -->
      <Grid Margin="{StaticResource PageHeaderPadding}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="你好，玩家" Style="{StaticResource PageTitleText}" />
          <!-- Bound to the library summary instead of the old slogan: this line now carries information. -->
          <TextBlock Text="{Binding Headline}" Style="{StaticResource PageSubtitleText}" />
        </StackPanel>

        <!-- The former stat cards, condensed: same numbers, read at a glance. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatusPill}"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  Padding="11,6"
                  Margin="6,0,0,0"
                  ToolTip="{Binding DetectionSummaryText}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="游戏" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DetectedGames}"
                         Style="{StaticResource StatusPillText}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding ManagedSummary}"
                         Style="{StaticResource CaptionText}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource StatusPill}"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  Padding="11,6"
                  Margin="6,0,0,0"
                  ToolTip="{Binding HeaderSummary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="已启用 Mod" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TotalEnabled}"
                         Style="{StaticResource StatusPillText}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding DisabledSummary}"
                         Style="{StaticResource CaptionText}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Download counts used to be a third card at the bottom of the page; two numbers belong here. -->
          <Border Style="{StaticResource StatusPill}"
                  Background="{DynamicResource SurfaceMutedBrush}"
                  Padding="11,6"
                  Margin="6,0,0,0"
                  ToolTip="进行中的下载与失败的下载">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="下载" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ActiveDownloads}"
                         Style="{StaticResource StatusPillText}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock Text="进行中"
                         Style="{StaticResource CaptionText}"
                         Margin="4,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding FailedDownloads, StringFormat={}{0} 失败}"
                         Style="{StaticResource CaptionText}"
                         Foreground="{DynamicResource DangerBrush}"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding FailedDownloads, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource StatusPill}"
                  Background="{DynamicResource WarningFillBrush}"
                  Padding="11,6"
                  Margin="6,0,0,0"
                  ToolTip="{Binding MissingDependencySummary}"
                  Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="冲突" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding TotalConflicts}"
                         Style="{StaticResource StatusPillText}"
                         Foreground="{DynamicResource WarningBrush}"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ===================== Body ===================== -->
      <Grid Margin="{StaticResource PageBodyPadding}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="420" />
          <ColumnDefinition Width="336" />
        </Grid.ColumnDefinitions>

        <!-- Left: the game, then the library, then actions -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">

          <!-- Startup recovery, shown only when a previous run actually repaired something. -->
          <Border Style="{StaticResource Callout}"
                  Background="{DynamicResource WarningFillBrush}"
                  Margin="0,0,0,14"
                  Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="已从被中断的操作中恢复"
                         Style="{StaticResource BodyText}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="{Binding RecoveryMessage}"
                         Style="{StaticResource SecondaryText}"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <!--
            The active game. This is the one thing the page exists to make unambiguous: every install,
            deploy and conflict action on every other page applies to whatever is shown here. It is the
            page's only raised surface.
          -->
          <Border Style="{StaticResource Card}" Padding="0">
            <Grid Height="164">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="124" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Background="{DynamicResource SurfaceMutedBrush}"
                      CornerRadius="11,0,0,11">
                <Border.Clip>
                  <RectangleGeometry Rect="0,0,124,164" RadiusX="11" RadiusY="11" />
                </Border.Clip>
                <Image Source="{Binding ActiveGameCover}" Stretch="UniformToFill" />
              </Border>

              <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="当前游戏" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ActiveGameName}"
                           Style="{StaticResource TitleText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ActiveGameModText}"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding UpdateSummaryText}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,3,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Style="{StaticResource PrimaryButton}"
                          Content="管理游戏"
                          Command="{Binding OpenGamesCommand}" />
                  <Button Style="{StaticResource SecondaryButton}"
                          Content="检查冲突"
                          Margin="8,0,0,0"
                          Command="{Binding NavigateToConflictsCommand}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Game library: one compact tile per managed game. -->
          <TextBlock Text="游戏库" Style="{StaticResource SubtitleText}" Margin="0,22,0,10" />

          <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource FlatCard}"
                        Width="200"
                        Margin="0,0,10,10"
                        Padding="12,11"
                        ToolTip="{Binding ModRootPath}">
                  <StackPanel>
                    <!-- Every line is one line with an ellipsis; wrapped captions made the tiles ragged. -->
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding ModSummary}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Border Style="{StaticResource StatusPill}"
                              Background="{Binding SupportFill, Converter={StaticResource BrushPass}}">
                        <TextBlock Text="{Binding LoaderText}"
                                   Style="{StaticResource StatusPillText}"
                                   Foreground="{Binding SupportTone, Converter={StaticResource BrushPass}}" />
                      </Border>
                      <TextBlock Text="{Binding UpdateSummary}"
                                 Style="{StaticResource CaptionText}"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="{Binding ConflictSummary}"
                                 Style="{StaticResource CaptionText}"
                                 VerticalAlignment="Center"
                                 TextWrapping="NoWrap" />
                      <TextBlock Text="·"
                                 Style="{StaticResource CaptionText}"
                                 Margin="6,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DependencySummary}"
                                 Style="{StaticResource CaptionText}"
                                 VerticalAlignment="Center"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="还没有添加任何游戏。请到“游戏库”扫描本机 Steam 库，或按目录手动添加。"
                     Style="{StaticResource SecondaryText}"
                     Visibility="{Binding Games.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

          <!-- Quick actions. -->
          <TextBlock Text="快捷操作" Style="{StaticResource SubtitleText}" Margin="0,18,0,10" />

          <UniformGrid Columns="4" Rows="1">
            <Button Style="{StaticResource SecondaryButton}"
                    Height="60"
                    Margin="0,0,10,0"
                    Command="{Binding OpenOnlineModsCommand}"
                    ToolTip="在 Nexus Mods 上搜索并安装 Mod">
              <StackPanel>
                <TextBlock Text="&#xE774;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Text="浏览在线 Mod"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Button>

            <Button Style="{StaticResource SecondaryButton}"
                    Height="60"
                    Margin="0,0,10,0"
                    Command="{Binding OpenLocalModsCommand}"
                    ToolTip="管理已导入的 Mod">
              <StackPanel>
                <TextBlock Text="&#xE8B7;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Text="本地 Mod 管理"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Button>

            <Button Style="{StaticResource SecondaryButton}"
                    Height="60"
                    Margin="0,0,10,0"
                    Command="{Binding NavigateToConflictsCommand}"
                    ToolTip="查看文件冲突及其来源">
              <StackPanel>
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Text="检查冲突"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Button>

            <Button Style="{StaticResource SecondaryButton}"
                    Height="60"
                    Command="{Binding OpenGamesCommand}"
                    ToolTip="扫描、添加与管理游戏">
              <StackPanel>
                <TextBlock Text="&#xE7FC;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Text="游戏库"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Button>
          </UniformGrid>

          <!-- Anything that needs attention. -->
          <TextBlock Text="需要关注"
                     Style="{StaticResource SubtitleText}"
                     Margin="0,20,0,10"
                     Visibility="{Binding Issues.Count, Converter={StaticResource BoolToVisibility}}" />

          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Callout}"
                        Background="{Binding Fill, Converter={StaticResource BrushPass}}"
                        Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource StatusPill}"
                            Background="Transparent"
                            BorderBrush="{Binding Tone, Converter={StaticResource BrushPass}}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding Level}"
                                 Style="{StaticResource StatusPillText}"
                                 Foreground="{Binding Tone, Converter={StaticResource BrushPass}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Title}"
                                 Style="{StaticResource BodyText}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}"
                                 Style="{StaticResource SecondaryText}"
                                 Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Fix}"
                                 Style="{StaticResource CaptionText}"
                                 Foreground="{Binding Tone, Converter={StaticResource BrushPass}}"
                                 Margin="0,5,0,0"
                                 Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="一切正常，无需关注。"
                     Style="{StaticResource SecondaryText}"
                     Margin="0,0,0,4"
                     Visibility="{Binding Issues.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </StackPanel>

        <!-- Right: activity and installs. Flat sections, not floating cards: the hero is the only raised surface. -->
        <StackPanel Grid.Column="1">
          <TextBlock Text="最近活动" Style="{StaticResource SubtitleText}" Margin="0,0,0,10" />

          <Border Style="{StaticResource FlatCard}" Padding="14,12">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding RecentActivity}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Ellipse Grid.Column="0"
                               Width="6"
                               Height="6"
                               Fill="{Binding Tone, Converter={StaticResource BrushPass}}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0" />

                      <!-- Message first: it is the information; category and time are the footnote. -->
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource BodyText}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Message}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CaptionText}" />
                          <TextBlock Text="·"
                                     Style="{StaticResource CaptionText}"
                                     Margin="6,0" />
                          <TextBlock Text="{Binding TimeText}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="还没有活动记录。安装一个 Mod 后会显示在这里。"
                         Style="{StaticResource CaptionText}"
                         Margin="0,4,0,2"
                         Visibility="{Binding RecentActivity.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            </StackPanel>
          </Border>

          <TextBlock Text="最近安装" Style="{StaticResource SubtitleText}" Margin="0,18,0,10" />

          <Border Style="{StaticResource FlatCard}" Padding="14,12">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding RecentInstalls}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <TextBlock Text="{Binding Name}"
                                 Style="{StaticResource BodyText}"
                                 FontWeight="SemiBold"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Name}" />
                      <TextBlock Text="{Binding Detail}"
                                 Style="{StaticResource CaptionText}"
                                 Margin="0,2,0,0"
                                 TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="还没有安装任何 Mod。"
                         Style="{StaticResource CaptionText}"
                         Margin="0,4,0,2"
                         Visibility="{Binding RecentInstalls.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
